---
import BaseLayout from "../layouts/BaseLayout.astro";
import Arrow from "../components/Arrow.astro";
import Logo from "../components/Logo.astro";
import Marquee from "../components/Marquee.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { getPoles, poleVars } from "../data/poles";
import { getProjects } from "../lib/projects";
import { useT, url, rich, type Lang } from "../i18n";

interface Props { lang: Lang; alternates: Record<Lang, string>; poleId: string }
const { lang, alternates, poleId } = Astro.props;
const t = useT(lang);
const pd = t.poleDetail;
const poles = getPoles(lang);
const idx = poles.findIndex((p) => p.id === poleId);
const pole = poles[idx];
const projects = (await getProjects(lang)).filter((p) => p.data.pole === pole.id).slice(0, 2);
const tone = pole.colors.ink === "#ffffff" ? "light" : "dark";
const quoteUrl = `${url("contact", lang)}?pole=${pole.id}`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: pole.name,
  description: pole.intro,
  provider: { "@type": "Organization", name: "Nant'Unity" },
  areaServed: "Nantes",
  inLanguage: lang,
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: pole.name,
    itemListElement: pole.services.map((s) => ({ "@type": "Offer", itemOffered: { "@type": "Service", name: s.title, description: s.text } })),
  },
};
---

<BaseLayout lang={lang} alternates={alternates} title={pole.name} description={`${pole.tagline} ${pole.intro}`} headerTone={tone} poleStyle={poleVars(pole)} jsonLd={jsonLd} footer={false}>
  <section class="page-hero theme-pole phero">
    <div class="container phero__grid">
      <div>
        <nav aria-label={t.common.breadcrumb}>
          <ol class="breadcrumb" role="list">
            <li><a href={url("home", lang)}>{t.common.home}</a></li>
            <li><a href={url("poles", lang)}>{t.nav.poles}</a></li>
            <li aria-current="page">{pole.short}</li>
          </ol>
        </nav>
        <p class="label phero__label" data-reveal>{t.common.pole} {pole.index}</p>
        <h1 class="phero__title display lines">
          {pole.name.split(" & ").map((w, i, arr) => <span class="line"><span>{w}{i < arr.length - 1 && <span class="serif-i"> &amp;</span>}</span></span>)}
        </h1>
        <p class="phero__tag serif-i" data-reveal style="--d:2">{pole.tagline}</p>
        <div class="phero__actions" data-reveal style="--d:3">
          <a href={quoteUrl} class="btn btn--pole" data-magnetic>{t.common.quote} <Arrow /></a>
          <a href="#prestations" class="btn btn--ghost">{pd.ourPrestations}</a>
        </div>
      </div>
      <div class="phero__logo" data-reveal="scale" style="--d:2" data-parallax="0.06">
        <Logo variant={pole.logo} label={`Nant'Unity — ${pole.logoTagline}`} />
      </div>
    </div>
  </section>

  <Marquee class="theme-ink pmarquee" items={pole.keywords} duration={26} />

  <section class="section theme-paper">
    <div class="container intro">
      <p class="label intro__label" data-reveal>{pd.poleLabel}</p>
      <p class="intro__text" data-reveal>{pole.intro}</p>
    </div>
    <div class="container problems">
      <h2 class="problems__title display" data-reveal>{pd.problemsTitle} <span class="serif-i">{pd.problemsAccent}</span></h2>
      <ul class="problems__list" role="list">
        {
          pole.problems.map((pb, i) => (
            <li class="problem" data-reveal style={`--d:${i}`}>
              <span class="problem__q display" aria-hidden="true">?</span>
              <p>{pb}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="prestations" class="section theme-ink services">
    <div class="container">
      <div class="services__head">
        <p class="label text-accent" data-reveal>{pd.servicesLabel}</p>
        <h2 class="services__title display lines">
          {pd.servicesTitle.map((l) => <span class="line"><span set:html={rich(l, "serif-i text-accent")} /></span>)}
        </h2>
      </div>
      <ol class="services__list" role="list">
        {
          pole.services.map((s, i) => (
            <li class="service" data-reveal style={`--d:${i % 3}`} data-spotlight>
              <span class="service__num label">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="service__title">{s.title}</h3>
              <p class="service__text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section theme-white examples">
    <div class:list={["container examples__grid", projects.length === 0 && "examples__grid--solo"]}>
      <div>
        <p class="label" data-reveal>{pd.examplesLabel}</p>
        <h2 class="examples__title display" data-reveal>{pd.examplesTitle} <span class="serif-i">{pd.examplesAccent}</span></h2>
        <ul class="examples__list" role="list">
          {pole.examples.map((e, i) => <li data-reveal style={`--d:${i}`}><Arrow size={14} class="examples__arrow" />{e}</li>)}
        </ul>
      </div>
      {
        projects.length > 0 && (
          <div class="examples__projects">
            {projects.map((p, i) => <div data-reveal style={`--d:${i}`}><ProjectCard project={p} /></div>)}
          </div>
        )
      }
    </div>
  </section>

  <!-- La page se termine sur l'appel à l'action du pôle (pas de « Pôle suivant » ni de footer, cf. BaseLayout footer={false}) -->
  <CtaBand lang={lang} tone="pole" title={pd.ctaTitle} accent={pole.short.toLowerCase()} text={pd.ctaText} href={quoteUrl} />
</BaseLayout>

<style>
  .phero { min-height: 92svh; display: flex; align-items: center; }
  .phero__grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: var(--space-7); align-items: center; width: 100%; }
  .phero__label { color: var(--pole-title); margin-bottom: var(--space-4); }
  .phero__title { font-size: clamp(3.5rem, 1.5rem + 7.5vw, 10rem); color: var(--pole-title); line-height: 0.86; }
  .phero__title .serif-i { font-size: 0.8em; color: var(--pole-ink); }
  .phero__tag { font-size: var(--fs-2xl); margin-top: var(--space-5); line-height: 1.15; max-width: 22ch; }
  .phero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: var(--space-6); }
  .phero__logo { color: var(--pole-accent); padding: 8%; border-radius: var(--radius-l); background: color-mix(in srgb, var(--pole-bg) 80%, black); aspect-ratio: 1; display: grid; place-items: center; }
  .phero__logo :global(.logo) { width: 100%; }
  @media (max-width: 860px) { .phero__grid { grid-template-columns: 1fr; } .phero__logo { max-width: 420px; aspect-ratio: auto; } }

  :global(.pmarquee) { color: var(--pole-text); }

  .intro { display: grid; grid-template-columns: 1fr 3fr; gap: var(--gutter); }
  .intro__text { font-size: var(--fs-2xl); line-height: 1.25; font-weight: 500; font-stretch: 95%; }
  .problems { margin-top: var(--space-10); }
  .problems__title { font-size: var(--fs-3xl); margin-bottom: var(--space-7); }
  .problems__title .serif-i { color: var(--pole-text); }
  .problems__list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
  .problem { background: var(--surface); border-radius: var(--radius-m); padding: 1.5rem; display: grid; gap: 2.5rem; align-content: space-between; min-height: 230px; transition: background var(--dur), color var(--dur), transform var(--dur) var(--ease-out); }
  .problem:hover { background: var(--pole-bg); color: var(--pole-ink); transform: translateY(-6px); }
  .problem__q { font-size: 3.5rem; line-height: 1; color: var(--pole-text); transition: color var(--dur); }
  .problem:hover .problem__q { color: var(--pole-title); }
  .problem p { font-weight: 600; font-size: var(--fs-lg); line-height: 1.3; }
  @media (max-width: 960px) { .problems__list { grid-template-columns: 1fr 1fr; } .intro { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .problems__list { grid-template-columns: 1fr; } .problem { min-height: 0; } }

  .services__head { display: grid; gap: var(--space-5); margin-bottom: var(--space-8); }
  .services__title { font-size: var(--fs-3xl); }
  .services__list { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .service {
    position: relative; padding: clamp(1.5rem, 3vw, 2.5rem); min-height: 260px;
    border-right: 1px solid var(--line); border-bottom: 1px solid var(--line);
    display: flex; flex-direction: column; gap: 1rem; overflow: hidden; isolation: isolate;
  }
  .service::before {
    content: ""; position: absolute; inset: 0; z-index: -1; opacity: 0; transition: opacity var(--dur);
    background: radial-gradient(320px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--pole-bg) 85%, transparent), transparent 70%);
  }
  .service:hover::before { opacity: 1; }
  .service__num { color: var(--pole-text); }
  .service__title { font-family: var(--f-display); text-transform: uppercase; font-size: var(--fs-2xl); line-height: 1; margin-top: auto; }
  .service__text { color: var(--fg-muted); }
  @media (max-width: 960px) { .services__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .services__list { grid-template-columns: 1fr; } .service { min-height: 0; } }

  .examples__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .examples__grid--solo { grid-template-columns: 1fr; }
  .examples__grid--solo .examples__list { display: grid; grid-template-columns: repeat(2, 1fr); column-gap: var(--gutter); }
  @media (max-width: 760px) { .examples__grid--solo .examples__list { grid-template-columns: 1fr; } }
  .examples__title { font-size: var(--fs-3xl); margin: var(--space-5) 0 var(--space-6); }
  .examples__title .serif-i { color: var(--pole-text); }
  .examples__list li { display: flex; align-items: center; gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); font-weight: 600; font-size: var(--fs-lg); transition: padding var(--dur) var(--ease-out), color var(--dur); }
  .examples__list li:hover { padding-left: 0.75rem; color: var(--pole-text); }
  :global(.examples__arrow) { color: var(--pole-text); flex: none; }
  .examples__projects { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); }
  .examples__projects > :nth-child(2) { margin-top: 4rem; }
  @media (max-width: 960px) { .examples__grid { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .examples__projects { grid-template-columns: 1fr; } .examples__projects > :nth-child(2) { margin-top: 0; } }

</style>
