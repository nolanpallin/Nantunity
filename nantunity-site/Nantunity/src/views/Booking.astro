---
import BaseLayout from "../layouts/BaseLayout.astro";
import Heritage from "../components/Heritage.astro";
import Arrow from "../components/Arrow.astro";
import SlotPicker from "../components/SlotPicker.astro";
import { bookingConfig, bookingTypeIds } from "../data/booking";
import { site } from "../data/site";
import { useT, url, rich, type Lang } from "../i18n";

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const b = t.booking;
const types = bookingTypeIds.map((id) => ({ id, duration: bookingConfig.types[id].duration, ...b.types[id as keyof typeof b.types] }));
const i18n = {
  lang, prevMonth: b.prevMonth, nextMonth: b.nextMonth, pickDay: b.pickDay, noSlots: b.noSlots, slotsFor: b.slotsFor,
  loading: b.loading, loadError: b.loadError, tzLocal: b.tzLocal,
  errConflict: b.errConflict, errGeneric: b.errGeneric, errRate: b.errRate, errInvalid: b.errInvalid, submitting: b.submitting,
  errRequired: t.contact.errRequired, errEmail: t.contact.errEmail, phoneHint: b.phoneHint, demo: b.demo,
  requestNotice: b.requestNotice, requestSubmit: b.requestSubmit, requestSuccessTitle: b.requestSuccessTitle,
  requestSuccessText: b.requestSuccessText, requestMailtoText: b.requestMailtoText, requestMailSubject: b.requestMailSubject,
  typeNames: Object.fromEntries(types.map((ty) => [ty.id, ty.name])), email: site.contact.email,
};
---

<BaseLayout lang={lang} alternates={alternates} title={b.title} description={b.description}>
  <section class="page-hero theme-ink bhero has-motif">
    <div class="container">
      <p class="page-hero__label label" data-reveal>{b.label}</p>
      <h1 class="page-hero__title display lines">
        {b.h1.map((l) => <span class="line"><span set:html={rich(l)} /></span>)}
      </h1>
      <p class="page-hero__intro muted" data-reveal style="--d:2">{b.intro}</p>
    </div>
  </section>

  <section class="section theme-paper booking" data-booking data-i18n={JSON.stringify(i18n)}>
    <div class="container">
      <p class="notice" data-notice hidden></p>
      <div class="notice notice--off" data-off hidden>
        <p>{b.notConfigured}</p>
        <a href={url("contact", lang)} class="btn btn--dark">{t.nav.contact} <Arrow /></a>
      </div>

      <div class="booking__flow" data-flow>
        <!-- 1. Type -->
        <fieldset class="bstep">
          <legend class="bstep__title"><span class="bstep__num display">01</span> {b.step1}</legend>
          <div class="types">
            {
              types.map((ty, i) => (
                <label class="type">
                  <input type="radio" name="type" value={ty.id} checked={i === 0} />
                  <span class="type__box">
                    <span class="type__dur label">{ty.duration} {b.minutes}</span>
                    <span class="type__name">{ty.name}</span>
                    <span class="type__text">{ty.text}</span>
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <!-- 2. Date & heure -->
        <div class="bstep" role="group" aria-labelledby="bstep2">
          <h2 class="bstep__title" id="bstep2"><span class="bstep__num display">02</span> {b.step2}</h2>
          <p class="bstep__tz">{b.tz}</p>
          <SlotPicker />
        </div>

        <!-- 3. Coordonnées -->
        <form class="bstep bform" data-form novalidate>
          <h2 class="bstep__title"><span class="bstep__num display">03</span> {b.step3}</h2>
          <div class="bform__selected" data-selected hidden>
            <span class="label">{b.selected}</span>
            <strong data-selected-label></strong>
            <a href="#bstep2" class="link-u bform__change">{b.change}</a>
          </div>
          <div class="hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
          <div class="bform__grid">
            <div class="field"><label for="b-first">{b.firstName} <span class="req" aria-hidden="true">*</span></label><input id="b-first" name="firstName" required maxlength="80" autocomplete="given-name" /><span class="field__error" aria-live="polite"></span></div>
            <div class="field"><label for="b-last">{b.lastName} <span class="req" aria-hidden="true">*</span></label><input id="b-last" name="lastName" required maxlength="80" autocomplete="family-name" /><span class="field__error" aria-live="polite"></span></div>
            <div class="field"><label for="b-email">{b.email} <span class="req" aria-hidden="true">*</span></label><input id="b-email" name="email" type="email" required maxlength="160" autocomplete="email" /><span class="field__error" aria-live="polite"></span></div>
            <div class="field"><label for="b-company">{b.company}</label><input id="b-company" name="company" maxlength="160" autocomplete="organization" /></div>
            <div class="field bform__full"><label for="b-subject">{b.subject} <span class="req" aria-hidden="true">*</span></label><input id="b-subject" name="subject" required maxlength="200" /><span class="field__error" aria-live="polite"></span></div>
            <div class="field">
              <label for="b-channel">{b.channel}</label>
              <select id="b-channel" name="channel">{b.channels.map((c) => <option>{c}</option>)}</select>
            </div>
            <div class="field"><label for="b-phone">{b.phone}</label><input id="b-phone" name="phone" type="tel" maxlength="40" autocomplete="tel" aria-describedby="b-phone-hint" /><span class="field__hint" id="b-phone-hint">{b.phoneHint}</span><span class="field__error" aria-live="polite"></span></div>
            <div class="field bform__full"><label for="b-msg">{b.message}</label><textarea id="b-msg" name="message" rows="4" maxlength="1000"></textarea></div>
          </div>
          <label class="consent"><input type="checkbox" name="consent" required /><span>{b.consent} <span class="req" aria-hidden="true">*</span></span></label>
          <p class="form-notice">{t.privacyNotice} <a href={url("privacy", lang)}>{t.privacyLink}</a>.</p>
          <div class="bform__foot">
            <p class="form__req">{t.common.required}</p>
            <button type="submit" class="btn" disabled data-submit><span data-submit-label>{b.submit}</span> <Arrow /></button>
          </div>
          <p class="status" role="status" aria-live="polite" data-status></p>
        </form>
      </div>

      <div class="success" data-success hidden tabindex="-1">
        <span class="success__mark display" aria-hidden="true">✓</span>
        <h2 class="display success__title" data-success-title>{b.successTitle}</h2>
        <p class="success__when" data-success-when></p>
        <p class="muted" data-success-text>{b.successText}</p>
        <div class="success__actions">
          <a class="btn" data-success-manage href="#">{b.manageLink} <Arrow /></a>
          <a class="btn btn--ghost" data-success-ics download="rendez-vous-nantunity.ics" href="#">{b.addToCalendar}</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { mountPicker, slotLabel } from "../scripts/booking";

  const root = document.querySelector<HTMLElement>("[data-booking]")!;
  const i18n = JSON.parse(root.dataset.i18n!);
  const form = root.querySelector<HTMLFormElement>("[data-form]")!;
  const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
  const status = form.querySelector<HTMLElement>("[data-status]")!;
  const selectedBox = form.querySelector<HTMLElement>("[data-selected]")!;
  const notice = root.querySelector<HTMLElement>("[data-notice]")!;
  let slot: string | null = null;
  let mode: "calendar" | "request" = "calendar";
  const typeValue = () => (root.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value ?? "premier-echange");

  const picker = mountPicker(root.querySelector("[data-picker]")!, i18n, {
    type: typeValue(),
    onSelect(iso) {
      slot = iso;
      submit.disabled = !iso;
      selectedBox.hidden = !iso;
      if (iso) {
        form.querySelector("[data-selected-label]")!.textContent = slotLabel(iso, i18n.lang);
        if (window.matchMedia("(max-width: 760px)").matches) form.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    },
    onStatus(r) {
      if (!r.configured) {
        root.querySelector<HTMLElement>("[data-flow]")!.hidden = true;
        root.querySelector<HTMLElement>("[data-off]")!.hidden = false;
      }
      if (r.demo) { notice.hidden = false; notice.textContent = i18n.demo; }
      if (r.mode === "request") {
        mode = "request";
        notice.hidden = false;
        notice.textContent = i18n.requestNotice;
        form.querySelector("[data-submit-label]")!.textContent = i18n.requestSubmit;
      }
    },
  });

  // Affiche l'écran de confirmation (réservation confirmée ou simple demande)
  function showSuccess(start: string, opts: { title?: string; text?: string; manageUrl?: string; ics?: string }) {
    root.querySelector<HTMLElement>("[data-flow]")!.hidden = true;
    notice.hidden = true;
    const ok = root.querySelector<HTMLElement>("[data-success]")!;
    ok.hidden = false;
    if (opts.title) ok.querySelector("[data-success-title]")!.textContent = opts.title;
    if (opts.text) ok.querySelector("[data-success-text]")!.textContent = opts.text;
    ok.querySelector("[data-success-when]")!.textContent = slotLabel(start, i18n.lang);
    const manage = ok.querySelector<HTMLAnchorElement>("[data-success-manage]")!;
    const ics = ok.querySelector<HTMLAnchorElement>("[data-success-ics]")!;
    manage.hidden = !opts.manageUrl;
    ics.hidden = !opts.ics;
    if (opts.manageUrl) manage.href = opts.manageUrl;
    if (opts.ics) ics.href = URL.createObjectURL(new Blob([opts.ics], { type: "text/calendar" }));
    ok.focus();
    ok.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  // Repli sans service d'e-mail : demande pré-remplie dans la messagerie du visiteur
  function mailtoRequest(data: Record<string, unknown>) {
    const v = (k: string) => String(data[k] ?? "").trim();
    const blocks = [
      `${i18n.typeNames[v("type")] ?? v("type")} — ${slotLabel(v("start"), i18n.lang)} (Europe/Paris)`,
      [`${v("firstName")} ${v("lastName")}`, v("email"), v("company"), v("phone"), v("channel")].filter(Boolean).join("\n"),
      v("subject"),
      v("message"),
    ].filter(Boolean);
    location.href = `mailto:${i18n.email}?subject=${encodeURIComponent(`${i18n.requestMailSubject} — ${v("firstName")} ${v("lastName")}`)}&body=${encodeURIComponent(blocks.join("\n\n"))}`;
  }
  root.querySelectorAll<HTMLInputElement>('input[name="type"]').forEach((r) => r.addEventListener("change", () => picker.setType(r.value)));

  const setStatus = (text: string, state = "") => { status.textContent = text; status.dataset.state = state; };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!slot) return;
    form.querySelectorAll(".is-invalid").forEach((el) => el.classList.remove("is-invalid"));
    form.querySelectorAll(".field__error").forEach((el) => (el.textContent = ""));
    const phone = form.elements.namedItem("phone") as HTMLInputElement;
    const channel = form.elements.namedItem("channel") as HTMLSelectElement;
    phone.required = channel.selectedIndex === 1; // rendez-vous téléphonique → numéro obligatoire
    if (!form.checkValidity()) {
      const invalid = [...form.querySelectorAll<HTMLInputElement>(":invalid")];
      invalid.forEach((el) => {
        const w = el.closest(".field, .consent");
        w?.classList.add("is-invalid");
        el.setAttribute("aria-invalid", "true");
        const err = w?.querySelector(".field__error");
        if (err) err.textContent = el.type === "email" && el.value ? i18n.errEmail : el === phone ? i18n.phoneHint : i18n.errRequired;
      });
      invalid[0]?.focus();
      setStatus(i18n.errRequired, "error");
      return;
    }
    form.querySelectorAll("[aria-invalid]").forEach((el) => el.removeAttribute("aria-invalid"));
    const data = Object.fromEntries(new FormData(form).entries()) as Record<string, unknown>;
    Object.assign(data, { consent: true, type: typeValue(), start: slot, lang: i18n.lang });
    submit.disabled = true;
    setStatus(i18n.submitting);
    try {
      const res = await fetch("/api/booking", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
      const json = await res.json().catch(() => ({}));
      if (res.status === 409) { setStatus(i18n.errConflict, "error"); picker.refresh(); return; }
      if (res.status === 429) { setStatus(i18n.errRate, "error"); return; }
      if (res.status === 400) { setStatus(i18n.errInvalid, "error"); return; }
      if (res.status === 503 && json.mode === "request") {
        mailtoRequest(data);
        setStatus("");
        showSuccess(String(data.start), { title: i18n.requestSuccessTitle, text: i18n.requestMailtoText });
        return;
      }
      if (!res.ok || !json.ok) throw new Error();
      if (json.mode === "request") showSuccess(json.start, { title: i18n.requestSuccessTitle, text: i18n.requestSuccessText });
      else showSuccess(json.start, { manageUrl: json.manageUrl, ics: json.ics });
      setStatus("");
    } catch {
      setStatus(i18n.errGeneric, "error");
    } finally {
      submit.disabled = !slot;
    }
  });
</script>

<style>
  .bhero { padding-bottom: clamp(2.5rem, 5vw, 4rem); }
  .booking { padding-top: clamp(2.5rem, 5vw, 4rem); }
  .booking__flow { display: grid; gap: clamp(2.5rem, 5vw, 4rem); }
  .booking__flow[hidden] { display: none; }
  .notice { padding: 1rem 1.25rem; border-radius: var(--radius-m); background: color-mix(in srgb, var(--c-orange) 25%, transparent); font-weight: 600; margin-bottom: 2rem; }
  .notice--off { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding: 1.5rem; }
  .notice[hidden] { display: none; }

  .bstep { border: 0; padding: 0; margin: 0; min-width: 0; }
  .bstep__title { display: flex; align-items: center; gap: 1rem; font-weight: 800; font-size: var(--fs-xl); margin-bottom: 1.25rem; font-stretch: 105%; }
  .bstep__num { font-size: var(--fs-2xl); color: var(--accent-display); font-weight: 400; }
  .bstep__tz { color: var(--fg-muted); font-size: var(--fs-sm); margin: -0.75rem 0 1.25rem; }

  .types { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .type { position: relative; cursor: pointer; }
  .type input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .type__box { display: grid; gap: 0.5rem; align-content: start; height: 100%; padding: 1.5rem; border-radius: var(--radius-l); background: var(--surface); border: 2px solid transparent; transition: border-color var(--dur), background var(--dur), transform var(--dur-fast); }
  .type:hover .type__box { border-color: var(--line-strong); }
  .type input:checked + .type__box { border-color: var(--c-orange); background: color-mix(in srgb, var(--c-orange) 14%, var(--surface)); }
  .type input:focus-visible + .type__box { box-shadow: var(--focus); }
  .type__dur { color: var(--accent-text); }
  .type__name { font-family: var(--f-display); text-transform: uppercase; font-size: var(--fs-xl); line-height: 1; }
  .type__text { color: var(--fg-muted); font-size: var(--fs-sm); }
  @media (max-width: 760px) { .types { grid-template-columns: 1fr; } }

  .bform { background: var(--surface); border-radius: var(--radius-l); padding: clamp(1.25rem, 4vw, 2.5rem); display: grid; gap: 1.25rem; }
  .bform__selected { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding: 1rem 1.25rem; border-radius: var(--radius-m); background: var(--inverse-bg); color: var(--inverse-fg); }
  .bform__selected[hidden] { display: none; }
  .bform__selected .label { opacity: 0.75; }
  .bform__selected strong { display: inline-block; }
  .bform__selected strong::first-letter { text-transform: uppercase; }
  .bform__change { margin-left: auto; font-size: var(--fs-sm); font-weight: 600; }
  .bform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem 1.5rem; }
  .bform__full { grid-column: 1 / -1; }
  @media (max-width: 600px) { .bform__grid { grid-template-columns: 1fr; } }
  .bform__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 1rem; }
  .form__req { font-size: var(--fs-xs); color: var(--fg-muted); }

  .success { text-align: center; display: grid; justify-items: center; gap: 1rem; padding: clamp(2rem, 6vw, 5rem) 1rem; background: var(--surface); border-radius: var(--radius-l); outline: none; }
  .success[hidden] { display: none; }
  .success__mark { width: 84px; height: 84px; border-radius: 50%; background: var(--c-orange); color: var(--c-black); display: grid; place-items: center; font-size: 2.5rem; animation: pop 700ms var(--ease-out); }
  @keyframes pop { from { transform: scale(0); } }
  .success__title { font-size: var(--fs-3xl); }
  .success__when { font-weight: 700; font-size: var(--fs-lg); }
  .success__when::first-letter { text-transform: uppercase; }
  .success__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.75rem; margin-top: 0.5rem; }
  .success__actions a[hidden] { display: none; }
</style>
