---
/** Icônes des réseaux sociaux (traits simples, couleur = currentColor, s'adaptent aux thèmes). */
interface Props { name: string; size?: number }
const { name, size = 22 } = Astro.props;
---

{
  name === "Instagram" && (
    <svg class="social-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.9" />
      <circle cx="12" cy="12" r="4.4" stroke="currentColor" stroke-width="1.9" />
      <circle cx="17.6" cy="6.4" r="1.25" fill="currentColor" />
    </svg>
  )
}
{
  name === "LinkedIn" && (
    <svg class="social-icon" width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <rect x="2.5" y="2.5" width="19" height="19" rx="4" fill="none" stroke="currentColor" stroke-width="1.9" />
      <path d="M7.5 10.5v6M7.5 7.6v.1M11 16.5v-3.6c0-1.4 1-2.4 2.3-2.4s2.2 1 2.2 2.4v3.6M11 10.5v6" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" fill="none" />
    </svg>
  )
}
{
  name === "TikTok" && (
    <svg class="social-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.2 4.3 5 4.5" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" />
    </svg>
  )
}
{
  name === "Facebook" && (
    <svg class="social-icon" width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
      <path d="M14.5 21v-7.5h2.6l.4-3h-3V8.7c0-.9.3-1.5 1.6-1.5h1.5V4.5a20 20 0 0 0-2.3-.1c-2.3 0-3.8 1.4-3.8 3.9v2.2H9v3h2.5V21" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
    </svg>
  )
}
