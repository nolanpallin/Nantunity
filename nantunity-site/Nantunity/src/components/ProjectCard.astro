---
import ProjectCover from "./ProjectCover.astro";
import Arrow from "./Arrow.astro";
import { getPole, poleVars } from "../data/poles";
import { useT, url } from "../i18n";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  size?: "default" | "large";
  headingLevel?: "h2" | "h3";
}
const { project, size = "default", headingLevel = "h3" } = Astro.props;
const lang = project.lang;
const t = useT(lang);
const d = project.data;
const pole = getPole(d.pole, lang)!;
const H = headingLevel;
---

<article class:list={["pcard", `pcard--${size}`]} style={poleVars(pole)} data-pole={d.pole}>
  <a href={url("projects", lang, project.slug)} class="pcard__link">
    <div class="pcard__media">
      <ProjectCover pole={d.pole} lang={lang} pattern={d.pattern} cover={d.cover} alt="" />
      <span class="pcard__view" aria-hidden="true"><Arrow size={22} /></span>
    </div>
    <div class="pcard__body">
      <p class="pcard__meta label"><span class="dot"></span>{pole.name} · {d.year}</p>
      <H class="pcard__title">{d.title}</H>
      <p class="pcard__summary">{d.summary}</p>
      <span class="pcard__more label">{t.common.seeProject} <Arrow size={12} /></span>
    </div>
  </a>
</article>

<style>
  .pcard__link { display: block; }
  .pcard__media { position: relative; overflow: hidden; border-radius: var(--radius-m); }
  .pcard__media :global(.cover) { transition: transform 900ms var(--ease-out); }
  .pcard__link:hover .pcard__media :global(.cover) { transform: scale(1.05); }
  .pcard__media::after {
    content: ""; position: absolute; inset: 0; background: var(--pole-bg);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0 100%); opacity: 0.2;
    transition: clip-path 700ms var(--ease-out);
  }
  .pcard__link:hover .pcard__media::after { clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); }
  .pcard__view {
    position: absolute; right: 1rem; bottom: 1rem; z-index: 2;
    width: 56px; height: 56px; border-radius: 50%;
    display: grid; place-items: center;
    background: var(--pole-accent); color: var(--pole-on-accent);
    transform: scale(0) rotate(-45deg);
    transition: transform 500ms var(--ease-out);
  }
  .pcard__link:hover .pcard__view, .pcard__link:focus-visible .pcard__view { transform: scale(1) rotate(-45deg); }
  .pcard__body { padding-top: 1.1rem; }
  .pcard__meta { display: flex; align-items: center; gap: 0.5rem; font-size: 0.6875rem; letter-spacing: 0.18em; color: var(--fg-muted); }
  .pcard__title { font-family: var(--f-sans); font-weight: 700; font-size: var(--fs-xl); line-height: 1.2; margin-top: 0.5rem; }
  .pcard--large .pcard__title { font-size: var(--fs-2xl); }
  .pcard__summary { margin-top: 0.5rem; font-size: var(--fs-sm); color: var(--fg-muted); max-width: 52ch; }
  .pcard__more { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 0.9rem; color: var(--pole-text); font-size: 0.6875rem; }
  .pcard__more :global(svg) { transition: transform var(--dur) var(--ease-out); }
  .pcard__link:hover .pcard__more :global(svg) { transform: translateX(5px); }
</style>
