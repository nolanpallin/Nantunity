---
/** Sélecteur FR | EN : renvoie vers la page équivalente dans l'autre langue et mémorise le choix. */
import { locales, langNames, useT, url, type Lang } from "../i18n";
interface Props { lang: Lang; alternates: Partial<Record<Lang, string>> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
---

<div class="lang" role="group" aria-label={t.common.langSwitch}>
  {
    locales.map((l, i) => (
      <>
        {i > 0 && <span class="lang__sep" aria-hidden="true">/</span>}
        {l === lang ? (
          <span class="lang__item is-current" aria-current="true" lang={l} title={langNames[l]}>{l.toUpperCase()}</span>
        ) : (
          <a class="lang__item" href={alternates[l] ?? url("home", l)} hreflang={l} lang={l} data-lang-switch={l} aria-label={langNames[l]}>
            {l.toUpperCase()}
          </a>
        )}
      </>
    ))
  }
</div>

<style>
  .lang { display: flex; align-items: center; gap: 0.15rem; font-weight: 700; font-size: 0.75rem; letter-spacing: 0.1em; }
  .lang__item { display: grid; place-items: center; min-width: 32px; height: 32px; border-radius: var(--radius-pill); }
  .lang__item.is-current { color: inherit; background: none; box-shadow: inset 0 0 0 1.5px currentColor; }
  a.lang__item { opacity: 0.8; transition: opacity var(--dur-fast); }
  a.lang__item:hover { opacity: 1; }
  .lang__sep { opacity: 0.35; }
</style>
