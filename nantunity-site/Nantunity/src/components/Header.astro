---
import Logo from "./Logo.astro";
import Arrow from "./Arrow.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LangSwitch from "./LangSwitch.astro";
import SocialLinks from "./SocialLinks.astro";
import { site } from "../data/site";
import { getPoles, poleVars } from "../data/poles";
import { useT, url, type Lang } from "../i18n";

interface Props { lang: Lang; alternates: Partial<Record<Lang, string>> }
const { lang, alternates } = Astro.props;
const t = useT(lang);
const poles = getPoles(lang);
const path = Astro.url.pathname;
const home = url("home", lang);
const isActive = (href: string) => (href === home ? path === home : path.startsWith(href));

const items = [
  { label: t.nav.projects, href: url("projects", lang) },
  { label: t.nav.about, href: url("about", lang) },
  { label: t.nav.contact, href: url("contact", lang) },
];
const mobileItems = [
  { label: t.nav.home, href: home },
  { label: t.nav.poles, href: url("poles", lang) },
  ...items,
  { label: t.nav.booking, href: url("booking", lang) },
];
---

<header class="hdr" data-header>
  <div class="hdr__inner container">
    <a href={home} class="hdr__logo" aria-label={`Nant'Unity — ${t.common.home}`}>
      <Logo variant="wordmark" decorative />
    </a>

    <nav class="hdr__nav" aria-label={t.common.mainNav}>
      <ul role="list">
        <li class="dd" data-dropdown>
          <a href={url("poles", lang)} class="link-u" aria-current={isActive(url("poles", lang)) ? "page" : undefined}>{t.nav.poles}</a>
          <button type="button" class="dd__toggle" aria-expanded="false" aria-controls="dd-poles" data-dropdown-toggle>
            <span class="visually-hidden">{t.nav.poles}</span>
            <svg width="10" height="7" viewBox="0 0 10 7" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          </button>
          <div class="dd__panel" id="dd-poles">
            <ul role="list">
              {
                poles.map((p) => (
                  <li style={poleVars(p)}>
                    <a href={url("poles", lang, p.urlSlug)} class="dd__item">
                      <span class="dd__num display">{p.index}</span>
                      <span>
                        <span class="dd__name">{p.name}</span>
                        <span class="dd__tag">{p.tagline}</span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </li>
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="link-u" aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hdr__tools">
      <LangSwitch lang={lang} alternates={alternates} />
      <ThemeToggle lang={lang} />
    </div>

    <a href={url("booking", lang)} class="btn btn--ghost hdr__book">{t.common.bookShort}</a>
    <a href={url("contact", lang)} class="btn hdr__cta" data-magnetic>{t.common.quote} <Arrow /></a>

    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" data-menu-toggle data-label-open={t.common.menuOpen} data-label-close={t.common.menuClose}>
      <span class="visually-hidden">{t.common.menuOpen}</span>
      <span class="hdr__burger-lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" data-menu hidden>
  <div class="menu__inner container">
    <nav aria-label={t.common.mobileNav}>
      <ol class="menu__list" role="list">
        {
          mobileItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                <span class="menu__num">0{i + 1}</span>
                <span class="display">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
    <a href={url("contact", lang)} class="btn menu__cta">{t.common.quote} <Arrow /></a>
    <div class="menu__foot">
      <a href={`mailto:${site.contact.email}`} class="link-u">{site.contact.email}</a>
      <SocialLinks lang={lang} />
    </div>
    <div class="menu__bars" aria-hidden="true">
      {poles.map((p) => <span style={poleVars(p)} />)}
    </div>
  </div>
</div>

<style>
  /* Couleurs de l'en-tête pilotées par 3 variables :
     --hdr-fg (texte), --hdr-logo (logo), --hdr-bg-hover (texte du bouton contour au survol).
     Par défaut (« auto ») elles suivent le thème ; sur un hero de couleur fixe elles sont forcées. */
  .hdr {
    --hdr-fg: var(--fg); --hdr-logo: var(--logo); --hdr-bg-hover: var(--bg-paper);
    position: fixed; inset: 0 0 auto; z-index: 100;
    height: var(--header-h);
    color: var(--hdr-fg);
    transition: transform var(--dur) var(--ease-out), background-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  :global(body[data-header-tone="light"]) .hdr:not(.is-scrolled) { --hdr-fg: #fff; --hdr-logo: var(--c-orange); --hdr-bg-hover: var(--c-black); }
  :global(body[data-header-tone="dark"]) .hdr:not(.is-scrolled) { --hdr-fg: var(--c-black); --hdr-logo: var(--c-black); --hdr-bg-hover: #fff; }
  .hdr.is-scrolled {
    background: var(--header-bg);
    box-shadow: 0 1px 0 var(--line);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  .hdr.is-hidden { transform: translateY(-100%); }
  :global(body.menu-open) .hdr { --hdr-fg: var(--fg); --hdr-logo: var(--logo); background: transparent; box-shadow: none; backdrop-filter: none; }
  .hdr__inner { height: 100%; display: flex; align-items: center; gap: clamp(0.75rem, 1.6vw, 1.75rem); }
  .hdr__logo { width: 58px; color: var(--hdr-logo); flex: none; transition: transform var(--dur) var(--ease-out), color var(--dur); }
  .hdr__logo:hover { transform: rotate(-3deg) scale(1.04); }
  .hdr__nav { margin-left: auto; }
  .hdr__nav > ul { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2.25rem); }
  .hdr__nav a { font-weight: 500; font-size: var(--fs-sm); letter-spacing: 0.01em; }
  .hdr__tools { display: flex; align-items: center; gap: 0.25rem; }
  .hdr__cta, .hdr__book { padding: 0.8rem 1.2rem; font-size: 0.75rem; }
  .hdr__book { --ghost: var(--hdr-fg); --btn-hover-fg: var(--hdr-bg-hover); }
  .hdr.is-scrolled .hdr__book { --btn-hover-fg: var(--bg-paper); }
  /* Sur un hero orange ou bleu clair, le bouton orange passe en noir pour rester visible */
  :global(body[data-header-tone="dark"]) .hdr:not(.is-scrolled) .hdr__cta { --btn-bg: var(--c-black); --btn-fg: #fff; --btn-hover-bg: #fff; --btn-hover-fg: var(--c-black); }

  /* Menu déroulant des pôles */
  .dd { position: relative; display: flex; align-items: center; gap: 0.3rem; }
  .dd__toggle { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; transition: transform var(--dur) var(--ease-out); }
  .dd__toggle[aria-expanded="true"] { transform: rotate(180deg); }
  .dd__panel {
    position: absolute; top: calc(100% + 18px); left: -1.5rem; width: 380px;
    padding: 0.6rem; border-radius: var(--radius-l);
    background: var(--surface-raised); color: var(--fg); box-shadow: var(--shadow-raised);
    border: 1px solid var(--line);
    opacity: 0; visibility: hidden; transform: translateY(-8px);
    transition: opacity var(--dur) var(--ease-out), transform var(--dur) var(--ease-out), visibility 0s linear var(--dur);
  }
  .dd__panel::before { content: ""; position: absolute; inset: -20px 0 auto; height: 20px; }
  .dd:hover .dd__panel, .dd.is-open .dd__panel { opacity: 1; visibility: visible; transform: none; transition-delay: 0s; }
  .dd__item { display: flex; gap: 1rem; align-items: center; padding: 0.8rem; border-radius: var(--radius-m); transition: background var(--dur-fast); }
  .dd__item:hover, .dd__item:focus-visible { background: var(--pole-bg); color: var(--pole-ink); }
  .dd__num { font-size: 1.6rem; color: var(--pole-text); width: 2.2rem; flex: none; transition: color var(--dur-fast); }
  .dd__item:hover .dd__num, .dd__item:focus-visible .dd__num { color: var(--pole-title); }
  .dd__name { display: block; font-weight: 700; }
  .dd__tag { display: block; font-size: var(--fs-xs); opacity: 0.75; font-weight: 400; }

  .hdr__burger { display: none; width: 48px; height: 48px; border-radius: 50%; background: var(--c-orange); color: var(--c-black); position: relative; z-index: 2; flex: none; }
  .hdr__burger-lines { position: absolute; inset: 0; display: grid; place-content: center; gap: 6px; }
  .hdr__burger-lines i { display: block; width: 20px; height: 2px; background: currentColor; transition: transform var(--dur) var(--ease-out); }
  .hdr__burger[aria-expanded="true"] i:first-child { transform: translateY(4px) rotate(45deg); }
  .hdr__burger[aria-expanded="true"] i:last-child { transform: translateY(-4px) rotate(-45deg); }

  @media (max-width: 1240px) { .hdr__book { display: none; } }
  @media (max-width: 1040px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__tools { margin-left: auto; }
    .hdr__burger { display: block; }
  }

  /* Menu plein écran (mobile) */
  .menu {
    position: fixed; inset: 0; z-index: 90;
    background: var(--bg-ink); color: var(--fg);
    padding-top: calc(var(--header-h) + 1.5rem);
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 700ms var(--ease-out);
  }
  .menu[hidden] { display: block; visibility: hidden; }
  .menu.is-open { clip-path: inset(0 0 0 0); visibility: visible; }
  .menu__inner { min-height: calc(100% - 2rem); display: flex; flex-direction: column; gap: var(--space-6); padding-bottom: 6rem; }
  .menu__list li { overflow: hidden; border-bottom: 1px solid var(--line); }
  .menu__list a { display: flex; align-items: baseline; gap: 1rem; padding: 0.5rem 0; transform: translateY(110%); transition: transform 700ms var(--ease-out), color var(--dur-fast); transition-delay: calc(var(--i) * 60ms + 150ms); }
  .menu.is-open .menu__list a { transform: none; }
  .menu__list .display { font-size: clamp(2.3rem, 10vw, 4.5rem); }
  .menu__list a:hover, .menu__list a[aria-current="page"] { color: var(--accent-display); }
  .menu__num { font-size: var(--fs-xs); font-weight: 700; opacity: 0.6; }
  .menu__cta { align-self: flex-start; }
  .menu__foot { display: flex; flex-direction: column; gap: 1rem; font-weight: 600; }
  .menu__socials { display: flex; gap: 1.5rem; flex-wrap: wrap; }
  .menu__bars { position: fixed; left: 0; right: 0; bottom: 0; height: 10px; display: flex; }
  .menu__bars span { flex: 1; background: var(--pole-bg); }
</style>
